# Toon Studio local configuration. Copy to .env and adjust if needed.
# Nothing in here is secret; it is kept out of git so each machine can differ.

# Port the web UI listens on. Always bound to 127.0.0.1, never to the whole network.
WEB_PORT=8080

# Where your drawings, recordings, motions, renders and backgrounds live.
# Relative to this directory. Back this folder up; everything else is disposable.
DATA_DIR=./data

# Parallel jobs for compiling mmcv during the first TorchServe build.
# Raise towards your CPU core count to speed it up; each job needs ~1 GB RAM.
MMCV_BUILD_JOBS=4
